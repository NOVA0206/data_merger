# -------------------------------------------------------------------------
# Frontend (Vercel Project Settings -> Environment Variables)
# -------------------------------------------------------------------------
# Leave empty to call the Python API functions on the same Vercel deployment
# (same-origin /api/*). Only set this if the backend is hosted elsewhere.
NEXT_PUBLIC_API_URL=

# -------------------------------------------------------------------------
# Backend (same Vercel project, since frontend + api/ deploy together)
# -------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in the Google Cloud OAuth client.
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used both to encrypt stored refresh tokens and to sign session JWTs.
GOOGLE_TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=https://your-app.vercel.app

# Postgres connection string (Neon / Supabase / Railway / Render Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# How many spreadsheets to read per "Processing" chunk (tune for Vercel timeout).
JOB_BATCH_SIZE=8

# Shared secret checked on POST /api/cron/advance-jobs (Vercel Cron sends this
# as the X-Cron-Secret header if you configure it under cron settings, or you
# can leave this blank while testing).
CRON_SECRET=
